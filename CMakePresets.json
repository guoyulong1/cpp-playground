{
  "version": 3,
  "cmakeMinimumRequired": { "major": 3, "minor": 21, "patch": 0 },
  "configurePresets": [
    {
      "name": "default",
      "displayName": "Debug",
      "generator": "Ninja",
      "binaryDir": "${sourceDir}/build/default",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Debug",
        "CMAKE_EXPORT_COMPILE_COMMANDS": "ON",
        "CMAKE_PREFIX_PATH": "/opt/ros/humble"
      }
    },
    {
      "name": "release",
      "displayName": "Release",
      "inherits": "default",
      "binaryDir": "${sourceDir}/build/release",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Release"
      }
    },
    {
      "name": "asan",
      "displayName": "Debug + ASan/UBSan",
      "inherits": "default",
      "binaryDir": "${sourceDir}/build/asan",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Debug",
        "CMAKE_CXX_FLAGS": "-fsanitize=address,undefined -fno-omit-frame-pointer"
      }
    },
    {
      "name": "cn",
      "displayName": "Debug（国内网络：使用 scripts/fetch-deps-cn.sh 预热的本地依赖）",
      "inherits": "default",
      "binaryDir": "${sourceDir}/build/cn",
      "cacheVariables": {
        "FETCHCONTENT_SOURCE_DIR_FMT": "$env{HOME}/.cache/cpp-playground-deps/fmt",
        "FETCHCONTENT_SOURCE_DIR_SPDLOG": "$env{HOME}/.cache/cpp-playground-deps/spdlog",
        "FETCHCONTENT_SOURCE_DIR_NLOHMANN_JSON": "$env{HOME}/.cache/cpp-playground-deps/nlohmann_json",
        "FETCHCONTENT_SOURCE_DIR_HTTPLIB": "$env{HOME}/.cache/cpp-playground-deps/httplib",
        "FETCHCONTENT_SOURCE_DIR_LIBZMQ": "$env{HOME}/.cache/cpp-playground-deps/libzmq",
        "FETCHCONTENT_SOURCE_DIR_CPPZMQ": "$env{HOME}/.cache/cpp-playground-deps/cppzmq"
      }
    }
  ],
  "buildPresets": [
    { "name": "default", "configurePreset": "default" },
    { "name": "release", "configurePreset": "release" },
    { "name": "asan", "configurePreset": "asan" },
    { "name": "cn", "configurePreset": "cn" }
  ],
  "testPresets": [
    {
      "name": "default",
      "configurePreset": "default",
      "output": { "outputOnFailure": true }
    },
    {
      "name": "asan",
      "configurePreset": "asan",
      "output": { "outputOnFailure": true }
    },
    {
      "name": "cn",
      "configurePreset": "cn",
      "output": { "outputOnFailure": true }
    }
  ]
}
